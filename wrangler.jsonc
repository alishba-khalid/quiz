{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "quizkraft",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding; the service name must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "quizkraft"
    }
  ],
  "images": {
    // Image optimization for next/image (blog images)
    "binding": "IMAGES"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "www.quizkraft.tech", "custom_domain": true },
    // The apex only exists to be redirected to www by a Cloudflare Redirect Rule.
    { "pattern": "quizkraft.tech", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
